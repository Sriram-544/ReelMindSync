{
  "manifest_version": 3,
  "name": "ReelMind Sync",
  "version": "2.0",
  "description": "Syncs your saved Instagram Reels to your local ReelMind server.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["button.css"],
      "run_at": "document_end"
    }
  ]
}
